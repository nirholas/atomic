{
  "name": "pump-launch-toolkit",
  "version": "0.1.0",
  "description": "Atomic pump.fun launch + fee collection + buy/transfer scripts using Jito bundles",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/atomic.git"
  },
  "homepage": "https://github.com/nirholas/atomic#readme",
  "bugs": {
    "url": "https://github.com/nirholas/atomic/issues"
  },
  "type": "commonjs",
  "scripts": {
    "metadata": "node src/metadata.js",
    "launch": "node src/fire-jito.js",
    "launch-single": "node src/fire-atomic-create.js",
    "collect": "node src/collect-jito.js",
    "watch": "node src/watch-collect.js",
    "buy": "node src/buy-jito.js",
    "transfer-tokens": "node src/rescue-tokens.js",
    "consolidate": "node src/consolidate.js",
    "distribute": "node src/distribute.js",
    "grind": "node src/grind.js",
    "check-funding": "tsx tools/check-pump-funding.ts",
    "sanity": "tsx tools/sanity-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^4.0.0",
    "@solana/kit": "^8.6.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.4",
    "bs58": "^6.0.0",
    "form-data": "^4.0.6",
    "node-fetch": "^3.3.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "bigint-buffer": "file:vendor/bigint-buffer"
  },
  "overrides": {
    "toml@<=5.0.0": "^5.0.1",
    "toml@<4.2.0": "^5.0.1",
    "toml@<4.1.2": "^5.0.1",
    "stream-json@<=3.5.0": "^3.6.0",
    "stream-json@<3.6.0": "^3.6.0",
    "stream-json@<=3.4.0": "^3.6.0",
    "uuid@<11.1.1": "^11.1.1",
    "bigint-buffer": "$bigint-buffer"
  }
}
